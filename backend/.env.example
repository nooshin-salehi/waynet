DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000
# PostgreSQL (پیش‌فرض). برای آزمایش سریع محلی می‌توان DB_ENGINE=sqlite گذاشت.
DB_ENGINE=postgresql
DB_NAME=waynet
DB_USER=waynet
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
MAX_VIDEO_BYTES=2147483648
VIDEO_TOKEN_TTL=7200
# production با nginx: VIDEO_ACCEL_REDIRECT_PREFIX=/_protected_video/
VIDEO_ACCEL_REDIRECT_PREFIX=
# کاوه‌نگار: کلید API و نام قالب Verify Lookup (در قالب باید %token باشد)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=registerverify
# قالب پیامک بازیابی رمز؛ اگر خالی باشد از همان KAVENEGAR_TEMPLATE استفاده می‌شود
KAVENEGAR_RESET_TEMPLATE=
KAVENEGAR_TIMEOUT=20
